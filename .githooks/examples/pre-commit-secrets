#!/usr/bin/env bash
set -euo pipefail

PATTERNS=(
    'AKIA[0-9A-Z]{16}'
    'ghp_[A-Za-z0-9]{36}'
    'sk-[A-Za-z0-9_-]{20,}'
    '-----BEGIN [A-Z ]*PRIVATE KEY-----'
    '(password|secret|api_?key|token)[[:space:]]*[:=][[:space:]]*"[^"]{8,}"'
)

echo "==> [pre-commit] Buscando secretos en los archivos del commit"

FOUND=0
while IFS= read -r file; do
    for pattern in "${PATTERNS[@]}"; do
        if matches=$(git show ":$file" | grep -nEi -e "$pattern"); then
            echo "[pre-commit] Posible secreto en $file:"
            echo "$matches" | sed 's/^/    línea /'
            FOUND=1
        fi
    done
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ "$FOUND" -eq 1 ]; then
    echo
    echo "[pre-commit] Commit cancelado. Quita el secreto y usa una variable de entorno."
    exit 1
fi

echo "==> [pre-commit] No se han encontrado secretos"
